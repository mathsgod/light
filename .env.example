# 複製此檔為 .env，填入本機設定；不要提交 .env 或真實密鑰。

# MySQL / MariaDB
DATABASE_HOSTNAME=127.0.0.1
DATABASE_PORT=3306
DATABASE_DATABASE=light
DATABASE_USERNAME=light
DATABASE_PASSWORD=
DATABASE_CHARSET=utf8mb4

TZ=Asia/Hong_Kong
API_PREFIX=/api

# 產生獨立隨機密鑰：php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
JWT_SECRET=

# 本機 HTTP：domain 留空，secure 留空（PHP 直接讀取此值，勿填字串 false）。
# 正式 HTTPS 環境設定 COOKIE_SECURE=1。
COOKIE_DOMAIN=
COOKIE_SECURE=
COOKIE_SAMESITE=Lax

# Google 登入（選填）
GOOGLE_CLIENT_ID=

# WebAuthn / Passkeys（RP_ID 只填 hostname，不包含協定或 port）
RP_ID=localhost
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3001

# OAuth Provider（需安裝 mathsgod/light-oauth2）
# 填好以下設定及金鑰後，改為 true。
OAUTH_ENABLED=false

# API 的公開網址；OAuth endpoints 位於此網址下的 /oauth/*。
# 本機前端和 API 統一使用 localhost，避免混用 127.0.0.1。
OAUTH_ISSUER=http://localhost:8888

# 受保護資源的 audience，改成實際資源網址。
OAUTH_RESOURCE=http://localhost:8888
# 選填：額外的 API resource audience。
OAUTH_API_RESOURCE=

# RSA 金鑰的檔案路徑（建議絕對路徑；不要提交私鑰）
# openssl genrsa -out /path/to/oauth-private.pem 2048
# openssl rsa -in /path/to/oauth-private.pem -pubout -out /path/to/oauth-public.pem
OAUTH_PRIVATE_KEY_PATH=
OAUTH_PUBLIC_KEY_PATH=

# 至少 32 字元；使用上述 random_bytes 指令另行產生，勿共用 JWT_SECRET。
OAUTH_ENCRYPTION_KEY=

# 以逗號分隔的可授權權限。
OAUTH_SCOPES=user.list
OAUTH_AUTO_SELECT_SCOPES=false
OAUTH_CIMD_ENABLED=false
OAUTH_DCR_ENABLED=false

# 設定在 API 後端，值指向 Nuxt 前端授權頁。
# 留空則使用後端內建授權頁；正式環境改為前端 HTTPS 網址。
OAUTH_AUTHORIZATION_UI_URL=http://localhost:3001/oauth/authorize
